# Supabase Configuration
# Get these from https://supabase.com/dashboard
#
# PUBLIC_SUPABASE_URL wajib memakai prefix PUBLIC_: lib/supabase/client.ts
# memakainya di browser, dan SvelteKit hanya mengekspos variabel PUBLIC_ ke sisi
# klien. Menamainya SUPABASE_URL saja membuat build gagal dengan
# MISSING_EXPORT, bukan error saat dijalankan.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# SMTP — notifikasi relief person (satu-satunya fitur yang mengirim email).
# Server-only: jangan beri prefix PUBLIC_, jangan pernah sampai ke browser.
# Gmail butuh App Password, bukan password akun biasa.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Pena <noreply@example.com>"
