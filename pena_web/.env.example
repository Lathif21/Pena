# PostgREST — akses database, berjalan di VPS yang sama dan hanya mendengar di
# loopback. Tidak ada kunci API: otorisasi sepenuhnya di kode server.
POSTGREST_URL=http://127.0.0.1:3001

# Alamat yang dipakai browser. adapter-node menolak POST form action kalau nilai
# ini tidak cocok, dan flag `secure` pada cookie sesi ikut menyala kalau https.
ORIGIN=http://localhost:5173

# Berkas unggahan (modul PDF, foto presensi). Sengaja di luar folder aplikasi
# supaya redeploy tidak pernah menghapusnya, dan di luar static/ supaya tidak
# pernah tersaji tanpa tanda tangan.
STORAGE_DIR=/srv/pena/data
# Kunci HMAC untuk signed URL. Buat dengan: openssl rand -hex 32
STORAGE_SIGNING_SECRET=

# SMTP — notifikasi relief person dan kode lupa password.
# Server-only: jangan beri prefix PUBLIC_, jangan pernah sampai ke browser.
# Gmail butuh App Password, bukan password akun biasa.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Pena <noreply@example.com>"
